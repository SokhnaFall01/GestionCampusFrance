# === Base de données PostgreSQL ===
# Connexion applicative (pooler Supabase en production, avec ?pgbouncer=true)
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true"
# Connexion directe (pour prisma db push / migrations)
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Secret de signature des sessions — générer avec: openssl rand -hex 32
AUTH_SECRET="a-remplacer-par-une-longue-chaine-aleatoire"

# === Stockage des fichiers ===
# En production (Supabase Storage) : renseigner ces 2 variables.
# En local, laisser vide pour utiliser le disque (UPLOAD_DIR).
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
# SUPABASE_BUCKET="documents"   # optionnel (défaut: documents)
UPLOAD_DIR="./uploads"

# === Compte administrateur (créé au seed / 1er déploiement) ===
# À définir AVANT le premier déploiement pour choisir vos identifiants.
# ADMIN_EMAIL="vous@exemple.com"
# ADMIN_PASSWORD="MotDePasseFort"
# ADMIN_NAME="Votre nom"

# Optionnel : autoriser le cookie de session en HTTP (auto-hébergement sans HTTPS)
# AUTH_INSECURE_COOKIE="true"
