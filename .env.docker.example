# === Configuration du déploiement Docker (VPS) ===
# Copiez ce fichier en ".env" sur le serveur et remplissez les valeurs.

# Votre nom de domaine (doit pointer vers l'IP du serveur). Sans "https://".
DOMAIN=exemple.mondomaine.com

# Mot de passe de la base PostgreSQL (choisissez-en un, lettres+chiffres).
POSTGRES_PASSWORD=changez-moi-un-mot-de-passe-solide

# Secret de session (déjà généré pour vous, unique) :
AUTH_SECRET=e0822c7a9baa34a3283aa5406e007cb35b67fc686bab740139005ddeeb803b2c

# Compte administrateur (votre connexion au site) :
ADMIN_EMAIL=sokhnamaifall50@gmail.com
ADMIN_PASSWORD=ChoisissezVotreMotDePasse
ADMIN_NAME=Accompagnatrice
